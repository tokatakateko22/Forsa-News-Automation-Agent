# ══════════════════════════════════════════════════════════════════════════════
# Forsa Financial News Agent — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the remote/cloud database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/forsa_news

# ── Google Gemini (LLM) ────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key

# Classification model (cheap, fast — used for relevance filtering)
GEMINI_CLASSIFY_MODEL=gemini-3.6-flash

# Summarization model (quality — used only for selected articles)
GEMINI_SUMMARIZE_MODEL=gemini-3.6-flash

# ── SerpAPI (News Search) ──────────────────────────────────────────────────────
SERPAPI_KEY=your-serpapi-key

# ── Email Delivery ────────────────────────────────────────────────────────────
# Provider: power_automate | microsoft365 | smtp
EMAIL_PROVIDER=power_automate
EMAIL_FROM=alerts@yourdomain.com
EMAIL_RECIPIENT=recipient@yourdomain.com
EMAIL_SUBJECT_PREFIX="Financial Market News"

# --- Provider Option 1: Power Automate HTTP Trigger Flow (zero admin rights needed) ---
# Create an Automated Cloud Flow in make.powerautomate.com:
# Trigger: "When an HTTP request is received"
# Action: "Send an email (V2)" using your Office 365 Outlook connection
# Paste the generated HTTP POST URL here:
POWER_AUTOMATE_WEBHOOK_URL=https://your-power-automate-flow-url

# --- Provider Option 2: Microsoft 365 / Azure Graph API (used when EMAIL_PROVIDER=microsoft365) ---
# MICROSOFT_TENANT_ID=your-tenant-id
# MICROSOFT_CLIENT_ID=your-client-id
# MICROSOFT_CLIENT_SECRET=your-client-secret

# --- Provider Option 3: Standard SMTP (used when EMAIL_PROVIDER=smtp) ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASS=your-password-or-app-password
# SMTP_USE_TLS=true

# ── Scheduling ─────────────────────────────────────────────────────────────────
# Frequency: daily | hourly | twice_daily | custom_cron
SCHEDULE_FREQUENCY=daily

# Time for daily/twice_daily execution (24h format, local timezone)
SCHEDULE_TIME=08:30

# For twice_daily, set a second time
# SCHEDULE_TIME_2=20:00

# For custom_cron, provide a standard cron expression (5 fields)
SCHEDULE_CRON=0 8 * * *

TIMEZONE=Africa/Cairo

# ── Processing Window ──────────────────────────────────────────────────────────
# Hours of overlap to add before the last-run timestamp (catches delayed articles)
OVERLAP_HOURS=2

# Maximum age of articles to retrieve (in hours) for the first ever run
INITIAL_LOOKBACK_HOURS=24

# ── Filtering Thresholds ───────────────────────────────────────────────────────
# Minimum importance score (0–100) for an event to be included in the email
IMPORTANCE_THRESHOLD=60

# Minimum relevance score (0–100) for an article to proceed past classification
RELEVANCE_THRESHOLD=50

# Cosine similarity threshold (0–1) for semantic deduplication
SIMILARITY_THRESHOLD=0.85

# Fuzzy title match threshold (0–100) for title-based deduplication
TITLE_SIMILARITY_THRESHOLD=85

# ── No-News Behaviour ──────────────────────────────────────────────────────────
# What to do when no important news is found: skip | send_empty
NO_NEWS_BEHAVIOUR=skip

# ── Retry & Resilience ─────────────────────────────────────────────────────────
# Number of retry attempts for failed HTTP requests
HTTP_RETRY_ATTEMPTS=3

# Timeout in seconds for each HTTP request
HTTP_TIMEOUT_SECONDS=30

# Number of retry attempts for email delivery
EMAIL_RETRY_ATTEMPTS=3

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
